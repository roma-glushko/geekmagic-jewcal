# TLS certificate bundle for HTTPS (hebcal.com)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Main task runs the render loop; TLS + JSON run on the fetch thread (own stack).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# WiFi buffers (no PSRAM on this board)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

# We block in HTTP calls on worker threads
CONFIG_ESP_TASK_WDT_INIT=n

# Spawned std::threads default to this stack size unless overridden
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
